# Trigger.dev production secret (tr_prod_sk_…)
TRIGGER_SECRET_KEY=

# ScrapeCreators
SCRAPECREATORS_API_KEY=
# cache (default) | offline (fixtures only) | live (always API)
SC_MODE=cache
# Vendor-side free cache window in hours (0 credits on hit)
SC_VENDOR_CACHE_HOURS=168
# Force a named file under fixtures/scrapecreators/
# SC_FIXTURE=last-x-raw.json

# Airtable (from scrape-kit)
AIRTABLE_TOKEN=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appkPrLfwDGwIIbTL
AIRTABLE_POSTS_TABLE=tblxevZB9wCX1N3WF
AIRTABLE_MEDIA_TABLE=tbly36b1qJiRbfEL2
AIRTABLE_PROFILES_TABLE=tblD49NYtqd3vdOTI
# Optional: local usage ledger (see docs/usage-events.md)
# AIRTABLE_USAGE_EVENTS_TABLE=

# Cloudflare R2 (from scrape-kit)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scrape-kit-media
R2_PUBLIC_BASE_URL=

# Scraps library cache bust. Same secret as `wrangler secret put LIBRARY_BUST_SECRET`.
# LIBRARY_BUST_URL is the deployed Worker origin plus /internal/library-cache/bust.
LIBRARY_BUST_URL=
LIBRARY_BUST_SECRET=

# Composio (optional for agent tooling)
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
COMPOSIO_AIRTABLE_ACCOUNT_ID=
